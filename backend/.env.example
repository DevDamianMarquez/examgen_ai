# Copy to backend/.env and fill in the values. Never commit the real .env.

APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (docker-compose overrides this with the "db" service)
DATABASE_URL=postgresql://examgen:examgen_pass@localhost:5432/examgen_db

# JWT: use a long random value in any shared environment
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM provider: any OpenAI-compatible API. Defaults target Groq.
GROQ_API_KEY=your-api-key
# Pick a current model from your provider's model list
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional: embeddings need a provider with an embeddings endpoint (e.g. OpenAI).
# If the provider does not support it, generation still works without embeddings.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
